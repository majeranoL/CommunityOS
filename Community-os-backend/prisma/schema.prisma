/////////////////////////////////////////////////////
// PAYMENT
/////////////////////////////////////////////////////

model Payment {
  id String @id @default(uuid()) @db.Uuid

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  assessmentId String?     @db.Uuid
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  residentId String   @db.Uuid
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  chargeTypeId String?     @db.Uuid
  chargeType   ChargeType? @relation(fields: [chargeTypeId], references: [id], onDelete: SetNull)

  paymentNumber   String        @db.VarChar(30)
  amount          Decimal       @db.Decimal(10, 2)
  paymentDate     DateTime
  method          PaymentMethod @default(CASH)
  referenceNumber String?       @db.VarChar(100)
  remarks         String?
  proofFileId     String?       @db.Uuid
  proofUrl        String?

  gatewayProvider String?       @db.VarChar(50)
  gatewayId       String?       @db.VarChar(100)
  checkoutUrl     String?
  gatewayMeta     Json?
  paidAt          DateTime?
  expiresAt       DateTime?

  status PaymentStatus @default(PENDING_VERIFICATION)

  verifiedById String?   @db.Uuid
  verifiedBy   User?     @relation(fields: [verifiedById], references: [id], onDelete: SetNull, "PaymentVerifiedBy")
  verifiedAt   DateTime?

  rejectionReason String?   @db.VarChar(500)
  rejectedById    String?   @db.Uuid
  rejectedBy      User?     @relation(fields: [rejectedById], references: [id], onDelete: SetNull, "PaymentRejectedBy")
  rejectedAt      DateTime?

  refundedById String?   @db.Uuid
  refundedBy   User?     @relation(fields: [refundedById], references: [id], onDelete: SetNull, "PaymentRefundedBy")
  refundedAt   DateTime?

  cancelledById String?   @db.Uuid
  cancelledBy   User?     @relation(fields: [cancelledById], references: [id], onDelete: SetNull, "PaymentCancelledBy")
  cancelledAt   DateTime?

  isImported    Boolean      @default(false)
  importBatchId String?      @db.Uuid
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  allocations PaymentAllocation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([communityId, paymentNumber])
  @@index([communityId])
  @@index([assessmentId])
  @@index([residentId])
  @@index([status])
  @@index([paymentDate])
  @@index([chargeTypeId])
  @@index([gatewayId])
}

