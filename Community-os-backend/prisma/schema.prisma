generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/////////////////////////////////////////////////////
// ENUMS
/////////////////////////////////////////////////////

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
  REJECTED
}

enum ResidentStatus {
  PENDING
  ACTIVE
  INACTIVE
  MOVED_OUT
}

enum ResidentType {
  OWNER
  RENTER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
  SEPARATED
}

enum CommunityStatus {
  ACTIVE
  INACTIVE
}

enum AccountStatus {
  PENDING
  ACTIVE
  LOCKED
  DISABLED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AnnouncementStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintCategory {
  SECURITY
  NOISE
  SANITATION
  PARKING
  PETS
  FACILITY
  UTILITIES
  NEIGHBOR
  OTHER
}

enum FacilityType {
  CLUBHOUSE
  FUNCTION_ROOM
  POOL
  GYM
  COURT
  PARK
  PLAYGROUND
  GARDEN
  OTHER
}

enum FacilityStatus {
  AVAILABLE
  MAINTENANCE
  CLOSED
}

enum FacilityItemLoanStatus {
  PENDING
  APPROVED
  RETURNED
  REJECTED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum HouseholdStatus {
  ACTIVE
  INACTIVE
}

enum VisitorStatus {
  EXPECTED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum VehicleType {
  CAR
  MOTORCYCLE
  TRUCK
  VAN
  BICYCLE
  OTHER
}

enum VehicleStatus {
  PENDING
  APPROVED
  ACTIVE
  REJECTED
  DEACTIVATED
  TRANSFERRED
  INACTIVE
}

enum PetSpecies {
  DOG
  CAT
  BIRD
  FISH
  REPTILE
  SMALL_ANIMAL
  OTHER
}

enum PetStatus {
  PENDING
  APPROVED
  ACTIVE
  REJECTED
  DEACTIVATED
  INACTIVE
}

enum StickerStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
}

enum UtilityType {
  ELECTRICITY
  WATER
  GARBAGE
  SEWERAGE
  INTERNET
  OTHER
}

enum StaffRole {
  SECURITY
  MAINTENANCE
  CLEANING
  ADMIN
  OTHER
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum MaintenanceCategory {
  ELECTRICAL
  PLUMBING
  LANDSCAPING
  STRUCTURAL
  ROADS
  FACILITY
  CLEANING
  OTHER
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CANCELLED
}

enum AssessmentStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
  CANCELLED
}

enum PaymentStatus {
  PENDING_VERIFICATION
  PROCESSING
  VERIFIED
  FAILED
  EXPIRED
  REJECTED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  GCASH
  CREDIT_CARD
  CHEQUE
  OTHER
  ONLINE
}

enum FinanceCategory {
  DUES
  SPECIAL_ASSESSMENT
  BOND
  FACILITY_FEE
  VEHICLE_STICKER
  PARKING_FEE
  UTILITY
  MEMBERSHIP_FEE
