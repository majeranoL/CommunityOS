enum ChargeRecurrence {
  RECURRING
  ONE_TIME
}

enum BillingPeriodStatus {
  OPEN
  PAID
  OVERDUE
  WAIVED
  CANCELLED
}

enum ImportBatchStatus {
  PROCESSING
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum DocumentCategory {
  POLICY
  MINUTES
  FINANCIAL
  NOTICE
  FORM
  OTHER
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EventStatus {
  DRAFT
  UPCOMING
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventCategory {
  GENERAL
  MEETING
  SOCIAL
  SPORTS
  WORKSHOP
  FUNDRAISER
  OTHER
}

enum VisitorCategory {
  ONE_TIME
  RECURRING
  SERVICE_PROVIDER
  CONTRACTOR
  DELIVERY
  OTHER
}

enum PollStatus {
  DRAFT
  OPEN
  CLOSED
}

enum NotificationType {
  SYSTEM
  COMPLAINT
  MAINTENANCE
  PAYMENT
  ASSESSMENT
  MESSAGE
  EVENT
  RESERVATION
  VISITOR
  ANNOUNCEMENT
  POLL
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PROCESSING
  PAID
  OVERDUE
  WAIVED
  VOID
}

enum PlanTier {
  STANDARD
  CUSTOM
}

/////////////////////////////////////////////////////
// COMMUNITY
/////////////////////////////////////////////////////

model Community {
  id String @id @default(uuid()) @db.Uuid

  code        String @unique @db.VarChar(20)
  slug        String @unique @db.VarChar(50)
  displayName String @db.VarChar(100)

  description   String?
  email         String? @db.VarChar(100)
  contactNumber String? @db.VarChar(20)
  address       String?
  logoUrl       String?

  primaryColor String? @db.VarChar(20)
  accentColor  String? @db.VarChar(20)
  sidebarColor String? @db.VarChar(20)
  faviconUrl   String?

  status CommunityStatus @default(ACTIVE)

  roles              Role[]
  users              User[]
  permissions        Permission[]
  residents          Resident[]
  announcements      Announcement[]
  complaints         Complaint[]
  facilities         Facility[]
  reservations       Reservation[]
  facilityItems      FacilityItem[]
  facilityItemLoans  FacilityItemLoan[]
  households         Household[]
  visitors           Visitor[]
  vehicles           Vehicle[]
  vehicleStickers    VehicleSticker[]
  pets               Pet[]
  staffMembers       Staff[]
  maintenances       Maintenance[]
  assessments        Assessment[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  expenses           Expense[]
  utilityExpenses    UtilityExpense[]
  utilityConfigs     UtilityConfig[]
  utilityReadings    UtilityReading[]
  chargeTypes        ChargeType[]
  billingPeriods     BillingPeriod[]
  importBatches      ImportBatch[]
  documents          Document[]
  events             Event[]
  notifications      Notification[]
  subscription       Subscription?
  invoices           Invoice[]
  billingExemptions  BillingExemption[]
  polls              Poll[]
  auditLogs          AuditLog[]
  settings           Setting[]
  uploads            Upload[]
  communityFeatures  CommunityFeature[]
  featureAuditLogs   FeatureAuditLog[]
  goodStandingQrs    GoodStandingQR[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
}

/////////////////////////////////////////////////////
// FEATURES
/////////////////////////////////////////////////////

enum FeatureType {
  STANDARD
  OPTIONAL
}

model Feature {
  id String @id @default(uuid()) @db.Uuid

  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String?

  type     FeatureType @default(OPTIONAL)
  isActive Boolean     @default(true)

  dependencies String[] @default([])

  configSchema Json?

  communityFeatures CommunityFeature[]
  planFeatures      PlanFeature[]
  auditLogs         FeatureAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
}

model CommunityFeature {
  id String @id @default(uuid()) @db.Uuid

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  featureId String  @db.Uuid
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)
  config  Json?

  enabledAt  DateTime?
  enabledBy  String?   @db.Uuid
  disabledAt DateTime?
  disabledBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([communityId, featureId])
  @@index([communityId])
  @@index([featureId])
}

model PlanFeature {
  id String @id @default(uuid()) @db.Uuid

  planId    String @db.Uuid
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId String @db.Uuid
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([planId, featureId])
  @@index([planId])
  @@index([featureId])
}

enum FeatureAuditAction {
  ASSIGNED
  ENABLED
  DISABLED
  REVOKED
  CONFIG_UPDATED
}

model FeatureAuditLog {
  id String @id @default(uuid()) @db.Uuid

  featureId String  @db.Uuid
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  action FeatureAuditAction

  actorId String? @db.Uuid
  details Json?

  createdAt DateTime @default(now())

  @@index([featureId])
  @@index([communityId])
  @@index([action])
  @@index([createdAt])
}

/////////////////////////////////////////////////////
// ACCOUNT
/////////////////////////////////////////////////////

model Account {
  id String @id @default(uuid()) @db.Uuid

  email        String @unique @db.VarChar(255)
  passwordHash String

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  status AccountStatus @default(PENDING)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  user User?

  sessions      Session[]
  refreshTokens RefreshToken[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([status])
}

/////////////////////////////////////////////////////
// OTP VERIFICATION
/////////////////////////////////////////////////////

enum OtpPurpose {
  REGISTER
}

model OtpVerification {
  id         String     @id @default(uuid()) @db.Uuid
  email      String     @db.VarChar(255)
  purpose    OtpPurpose @default(REGISTER)
  code       String     @db.VarChar(64)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

/////////////////////////////////////////////////////
// USER
/////////////////////////////////////////////////////

model User {
  id String @id @default(uuid()) @db.Uuid

  accountId String  @unique @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  residentId String?   @unique @db.Uuid
  resident   Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  referenceNumber String @db.VarChar(30)

  firstName  String  @db.VarChar(100)
  middleName String? @db.VarChar(100)
  lastName   String  @db.VarChar(100)

  phoneNumber String? @db.VarChar(20)
  avatarUrl   String?

  status UserStatus @default(ACTIVE)

  isPlatformAdmin Boolean @default(false)

  roles              UserRole[]
  assignedComplaints Complaint[]    @relation("ComplaintAssignedTo")
  notifications      Notification[]

  uploadedDocuments       Document[]
  organizedEvents         Event[]
  eventAttendances        EventAttendee[]
  createdPolls            Poll[]             @relation("PollCreatedBy")
  pollVotes               PollVote[]
  auditLogs               AuditLog[]
  uploads                 Upload[]
  updatedSettings         Setting[]          @relation("SettingUpdatedBy")
  updatedPlatformSettings PlatformSetting[]  @relation("PlatformSettingUpdatedBy")
  verifiedResidents       Resident[]         @relation("ResidentVerifiedBy")
  verifiedVehicles        Vehicle[]          @relation("VehicleVerifiedBy")
  grantedExemptions       BillingExemption[] @relation("ExemptionGrantedBy")
  verifiedPets            Pet[]              @relation("PetVerifiedBy")
  verifiedPayments        Payment[]          @relation("PaymentVerifiedBy")
  rejectedPayments        Payment[]          @relation("PaymentRejectedBy")
  refundedPayments        Payment[]          @relation("PaymentRefundedBy")
  cancelledPayments       Payment[]          @relation("PaymentCancelledBy")
  importedBatches         ImportBatch[]      @relation("ImportBatchImportedBy")
  createdExpenses         Expense[]
  verifiedStickers        VehicleSticker[]   @relation("StickerVerifiedBy")
  createdStickers         VehicleSticker[]   @relation("StickerCreatedBy")
  createdUtilityExpenses  UtilityExpense[]   @relation("UtilityExpenseCreatedBy")
  approvedItemLoans       FacilityItemLoan[] @relation("ItemLoanApprovedBy")
  rejectedItemLoans       FacilityItemLoan[] @relation("ItemLoanRejectedBy")
  recordedUtilityReadings UtilityReading[]   @relation("UtilityReadingRecordedBy")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([communityId, referenceNumber])
  @@index([communityId])
  @@index([status])
  @@index([lastName])
}

/////////////////////////////////////////////////////
// ROLE
/////////////////////////////////////////////////////

model Role {
  id String @id @default(uuid()) @db.Uuid

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(50)
  description String?

  isSystem Boolean @default(false)

  userRoles   UserRole[]
  permissions RolePermission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([communityId, name])
}

/////////////////////////////////////////////////////
// PERMISSION
/////////////////////////////////////////////////////

model Permission {
  id String @id @default(uuid()) @db.Uuid

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  code        String  @db.VarChar(100)
  module      String  @db.VarChar(50)
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([communityId, code])
}

/////////////////////////////////////////////////////
// USER ROLE
/////////////////////////////////////////////////////

model UserRole {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([userId, roleId])
}

/////////////////////////////////////////////////////
// ROLE PERMISSION
/////////////////////////////////////////////////////

model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([roleId, permissionId])
}

/////////////////////////////////////////////////////
// SESSION
/////////////////////////////////////////////////////

model Session {
  id String @id @default(uuid()) @db.Uuid

  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  ipAddress String? @db.VarChar(45)
  userAgent String?

  status SessionStatus @default(ACTIVE)

  expiresAt DateTime

  createdAt DateTime @default(now())
}

/////////////////////////////////////////////////////
// REFRESH TOKEN
/////////////////////////////////////////////////////

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  token String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([token])
}

/////////////////////////////////////////////////////
// RESIDENT
/////////////////////////////////////////////////////

model Resident {
  id String @id @default(uuid()) @db.Uuid

  /////////////////////////////////////////////////////
  // RELATIONSHIP
  /////////////////////////////////////////////////////

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  householdId String?    @db.Uuid
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  complaints   Complaint[]
  reservations Reservation[]
  itemLoans    FacilityItemLoan[]

  hostedVisitors Visitor[] @relation("VisitorHostResident")
  vehicles       Vehicle[]
  pets           Pet[]     @relation("PetCaretakerResident")
  payments       Payment[]
  user           User?

  /////////////////////////////////////////////////////
  // BASIC INFORMATION
  /////////////////////////////////////////////////////

  residentNumber String @db.VarChar(30)

  firstName  String  @db.VarChar(100)
  middleName String? @db.VarChar(100)
  lastName   String  @db.VarChar(100)
  suffix     String? @db.VarChar(20)

  /////////////////////////////////////////////////////
  // PERSONAL INFORMATION
  /////////////////////////////////////////////////////

  birthDate DateTime?

  gender Gender?

  civilStatus CivilStatus?

  /////////////////////////////////////////////////////
  // CONTACT INFORMATION
  /////////////////////////////////////////////////////

  phoneNumber String? @db.VarChar(20)

  email String? @db.VarChar(255)

  /////////////////////////////////////////////////////
  // ADDRESS
  /////////////////////////////////////////////////////

  block String? @db.VarChar(20)

  lot String? @db.VarChar(20)

  street String? @db.VarChar(100)

  address String?

  /////////////////////////////////////////////////////
  // FUTURE EXTENSIONS
  /////////////////////////////////////////////////////

  profilePhotoUrl String?

  remarks String?

  /////////////////////////////////////////////////////
  // STATUS
  /////////////////////////////////////////////////////

  status ResidentStatus @default(ACTIVE)

  residentType ResidentType @default(OWNER)

  movedOutAt DateTime?

  /////////////////////////////////////////////////////
  // VERIFICATION
  /////////////////////////////////////////////////////

  verifiedById        String?   @db.Uuid
  verifiedBy          User?     @relation("ResidentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt          DateTime?
  verificationRemarks String?

  /////////////////////////////////////////////////////
  // AUDIT
  /////////////////////////////////////////////////////

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  isImported    Boolean      @default(false)
  importBatchId String?      @db.Uuid
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull, "ResidentImportBatch")

  /////////////////////////////////////////////////////
  // INDEXES
  /////////////////////////////////////////////////////

  @@unique([communityId, residentNumber])
  @@index([communityId])
  @@index([communityId, householdId])
  @@index([residentNumber])
  @@index([lastName])
  @@index([status])
  @@index([communityId, lastName])
  @@index([importBatchId])
}

model Announcement {
  id String @id @default(uuid()) @db.Uuid

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  title String @db.VarChar(200)

  content String

  coverImageUrl String?

  status AnnouncementStatus @default(DRAFT)

  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([communityId])
  @@index([status])
  @@index([publishedAt])
}

model Complaint {
  id String @id @default(uuid()) @db.Uuid

  /////////////////////////////////////////////////////
  // RELATIONSHIPS
  /////////////////////////////////////////////////////

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  residentId String   @db.Uuid
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  /////////////////////////////////////////////////////
  // COMPLAINT DETAILS
  /////////////////////////////////////////////////////

  complaintNumber String @db.VarChar(30)

  title String @db.VarChar(200)

  description String

  category ComplaintCategory

  priority ComplaintPriority @default(MEDIUM)

  status ComplaintStatus @default(OPEN)

  /////////////////////////////////////////////////////
  // ASSIGNMENT
  /////////////////////////////////////////////////////

  assignedToId String? @db.Uuid

  assignedTo User? @relation("ComplaintAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  remarks String?

  attachmentFileIds String[] @default([])

  resolutionRemarks String?

  resolvedAt DateTime?

  /////////////////////////////////////////////////////
  // AUDIT
  /////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  /////////////////////////////////////////////////////
  // INDEXES
  /////////////////////////////////////////////////////

  @@unique([communityId, complaintNumber])
  @@index([communityId])
  @@index([residentId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
}

/////////////////////////////////////////////////////
// FACILITY
/////////////////////////////////////////////////////

model Facility {
  id String @id @default(uuid()) @db.Uuid

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  name        String       @db.VarChar(100)
  type        FacilityType
  description String?
  location    String?      @db.VarChar(200)
  capacity    Int?
  imageUrl    String?
  hourlyRate  Decimal?     @db.Decimal(10, 2)

  status FacilityStatus @default(AVAILABLE)

  reservations Reservation[]
  maintenances Maintenance[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([communityId])
  @@index([type])
  @@index([status])
}

///////////////////////////////////////////////////
// FACILITY ITEM (borrowable inventory)
///////////////////////////////////////////////////

model FacilityItem {
  id String @id @default(uuid()) @db.Uuid

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(100)
  category    String? @db.VarChar(50)
  description String?
  imageUrl    String? @db.VarChar(500)

  quantityTotal     Int      @default(0)
  quantityAvailable Int      @default(0)
  borrowFee         Decimal? @db.Decimal(10, 2)

  isActive Boolean @default(true)

  loans FacilityItemLoan[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([communityId])
  @@index([isActive])
}

model FacilityItemLoan {
  id String @id @default(uuid()) @db.Uuid

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  itemId String       @db.Uuid
  item   FacilityItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  residentId String   @db.Uuid
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  loanNumber  String   @db.VarChar(30)
  quantity    Int
  purpose     String?  @db.VarChar(300)
  neededFrom  DateTime
  neededUntil DateTime

  feePerUnit Decimal @default(0) @db.Decimal(10, 2)
  totalFee   Decimal @default(0) @db.Decimal(10, 2)

  assessmentId String?     @db.Uuid
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  status FacilityItemLoanStatus @default(PENDING)

  approvedById String?   @db.Uuid
  approvedBy   User?     @relation("ItemLoanApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  rejectedById    String?   @db.Uuid
  rejectedBy      User?     @relation("ItemLoanRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedAt      DateTime?
  rejectionReason String?   @db.VarChar(500)

  returnedAt DateTime?
  remarks    String?   @db.VarChar(500)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([communityId, loanNumber])
  @@index([communityId])
  @@index([itemId])
  @@index([residentId])
  @@index([status])
}

/////////////////////////////////////////////////////
// RESERVATION
/////////////////////////////////////////////////////

model Reservation {
  id String @id @default(uuid()) @db.Uuid

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  facilityId String   @db.Uuid
