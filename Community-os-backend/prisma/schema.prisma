  notes         String?

  gatewayProvider String? @db.VarChar(50)
  gatewayInvoiceId String? @db.VarChar(100)
  checkoutUrl    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([communityId, invoiceNumber])
  @@index([communityId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
}

/////////////////////////////////////////////////////
// BILLING EXEMPTION
/////////////////////////////////////////////////////

model BillingExemption {
  id          String    @id @default(uuid()) @db.Uuid
  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  reason    String    @db.VarChar(500)
  startDate DateTime
  endDate   DateTime?

  grantedById String @db.Uuid
  grantedBy   User   @relation("ExemptionGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([communityId])
  @@index([grantedById])
}

/////////////////////////////////////////////////////
// POLL
/////////////////////////////////////////////////////

model Poll {
  id String @id @default(uuid()) @db.Uuid

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  createdById String @db.Uuid
  createdBy   User   @relation("PollCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  title           String     @db.VarChar(200)
  description     String?
  status          PollStatus @default(DRAFT)
  isAnonymous     Boolean    @default(false)
  allowMultiple   Boolean    @default(false)
  allowAddOptions Boolean    @default(false)
  startAt         DateTime?
  endAt           DateTime?

  options PollOption[]
  votes   PollVote[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([communityId])
  @@index([createdById])
  @@index([status])
  @@index([endAt])
}

model PollOption {
  id String @id @default(uuid()) @db.Uuid

  pollId String @db.Uuid
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  text String @db.VarChar(200)

  votes PollVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pollId])
}

model PollVote {
  id String @id @default(uuid()) @db.Uuid

  pollId String @db.Uuid
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  optionId String     @db.Uuid
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([pollId, optionId, userId])
  @@index([pollId])
  @@index([optionId])
  @@index([userId])
}

/////////////////////////////////////////////////////
// AUDIT LOG
/////////////////////////////////////////////////////

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  actorId String? @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action    String  @db.VarChar(50)
  entity    String  @db.VarChar(100)
  entityId  String? @db.VarChar(100)
  before    Json?
  after     Json?
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(255)

  createdAt DateTime @default(now())

  @@index([communityId])
  @@index([actorId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

/////////////////////////////////////////////////////
// SETTING
/////////////////////////////////////////////////////

model Setting {
  id String @id @default(uuid()) @db.Uuid

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  key      String  @db.VarChar(100)
  value    Json?
  group    String  @db.VarChar(50)
  isPublic Boolean @default(false)

  updatedById String? @db.Uuid
  updatedBy   User?   @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([communityId, key])
  @@index([communityId])
  @@index([group])
}

/////////////////////////////////////////////////////
// PLATFORM SETTING
/////////////////////////////////////////////////////

model PlatformSetting {
  id String @id @default(uuid()) @db.Uuid

  key   String @unique @db.VarChar(100)
  value Json?
  group String @default("general") @db.VarChar(50)

  updatedById String? @db.Uuid
  updatedBy   User?   @relation("PlatformSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
}

/////////////////////////////////////////////////////
// UPLOAD
/////////////////////////////////////////////////////

model Upload {
  id String @id @default(uuid()) @db.Uuid

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  uploadedById String @db.Uuid
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  module       String @default("document") @db.VarChar(50)
  access       String @default("private") @db.VarChar(20)
  filename     String @db.VarChar(255)
  originalName String @db.VarChar(255)
  mimetype     String @db.VarChar(100)
  size         Int

  createdAt DateTime @default(now())

  @@index([communityId])
  @@index([uploadedById])
  @@index([communityId, createdAt])
}

/////////////////////////////////////////////////////
// UTILITY EXPENSES
/////////////////////////////////////////////////////

enum LateFeeType {
  NONE
  FIXED_AMOUNT
  PERCENT
}

enum UtilityRateMode {
  METERED
  FIXED
}

model UtilityConfig {
  id String @id @default(uuid()) @db.Uuid

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  utilityType UtilityType
  name        String      @db.VarChar(100)

  rateMode    UtilityRateMode @default(METERED)
  unitRate    Decimal?        @db.Decimal(10, 4)
  fixedRate   Decimal?        @db.Decimal(10, 2)
  tieredRates Json?

  chargeTypeId String     @db.Uuid
  chargeType   ChargeType @relation(fields: [chargeTypeId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  readings UtilityReading[]

  @@unique([communityId, utilityType])
  @@index([communityId])
  @@index([chargeTypeId])
}

model UtilityReading {
  id String @id @default(uuid()) @db.Uuid

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  utilityConfigId String        @db.Uuid
  utilityConfig   UtilityConfig @relation(fields: [utilityConfigId], references: [id], onDelete: Cascade)

  householdId String    @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  periodKey       String   @db.VarChar(10)
  previousReading Decimal? @db.Decimal(12, 2)
  currentReading  Decimal? @db.Decimal(12, 2)
  usage           Decimal? @db.Decimal(12, 2)

  readingDate  DateTime
  recordedById String   @db.Uuid
  recordedBy   User     @relation("UtilityReadingRecordedBy", fields: [recordedById], references: [id], onDelete: Cascade)

  notes String? @db.VarChar(500)

  isImported    Boolean      @default(false)
  importBatchId String?      @db.Uuid
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([utilityConfigId, householdId, periodKey])
  @@index([communityId])
  @@index([householdId])
  @@index([periodKey])
}

model UtilityExpense {
  id String @id @default(uuid()) @db.Uuid

  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  createdById String @db.Uuid
  createdBy   User   @relation("UtilityExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  utilityNumber   String        @db.VarChar(30)
  providerName    String        @db.VarChar(100)
  utilityType     UtilityType
  amount          Decimal       @db.Decimal(12, 2)
  expenseDate     DateTime
  billingPeriod   String?       @db.VarChar(50)
  paymentMethod   PaymentMethod
  referenceNumber String?       @db.VarChar(100)
  invoiceNumber   String?       @db.VarChar(100)
  description     String?       @db.VarChar(500)
  receiptFileId   String?       @db.Uuid

  isImported    Boolean      @default(false)
  importBatchId String?      @db.Uuid
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([communityId, utilityNumber])
  @@index([communityId])
  @@index([utilityType])
  @@index([providerName])
  @@index([expenseDate])
}
