DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/community_os?schema=public"

JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=15m

REFRESH_SECRET=change-me-refresh-secret
REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

CORS_ORIGINS=http://localhost:5173

# Set to true when served over HTTPS in production
COOKIE_SECURE=false
NODE_ENV=development

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@communityos.app
APP_URL=http://localhost:5173
