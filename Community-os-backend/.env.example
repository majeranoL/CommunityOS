DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/community_os?schema=public"

JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=15m

REFRESH_SECRET=change-me-refresh-secret
REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

CORS_ORIGINS=http://localhost:5173

# Set to true when served over HTTPS in production
COOKIE_SECURE=false
NODE_ENV=development

# Port the HTTP server binds to (defaults to 3000 when unset;
# Railway/Render/Vercel inject PORT automatically)
PORT=3000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@communityos.app
APP_URL=http://localhost:5173

# Optional — Sentry error tracking (leave empty to disable)
SENTRY_DSN=

# Optional — set to "true" in docker-compose to seed the DB on first boot
SEED_DB=false
