DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/community_os?schema=public"

JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=15m

REFRESH_SECRET=change-me-refresh-secret
REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

CORS_ORIGINS=http://localhost:5173

# Set to true when served over HTTPS in production
COOKIE_SECURE=false
NODE_ENV=development

# Port the HTTP server binds to (defaults to 3000 when unset;
# Railway/Render/Vercel inject PORT automatically)
PORT=3000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@communityos.app
APP_URL=http://localhost:5173

# Optional — Sentry error tracking (leave empty to disable)
SENTRY_DSN=

# Optional — S3-compatible object storage for uploads (Railway Bucket).
# When unset, uploads fall back to the local /app/uploads volume disk.
# In production these are wired as reference variables from the bucket service.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=
# Set to "true" only if the S3 endpoint requires path-style URLs
S3_FORCE_PATH_STYLE=false

# Optional — set to "true" in docker-compose to seed the DB on first boot
SEED_DB=false
